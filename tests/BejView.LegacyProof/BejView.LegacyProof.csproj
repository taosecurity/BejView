<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proof tests: they compile the unchanged 1.0 LargeFileHandler.cs and show each problem listed in PLAN.md.
       Each test asserts the faulty 1.0 behaviour, so a passing test means "the problem is real".
       The 1.0 source is kept as it was, so its warnings are not treated as errors here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1998;CS8618;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\legacy\winforms-1.0\LargeFileHandler.cs" Link="Legacy\LargeFileHandler.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
