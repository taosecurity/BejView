<Project Sdk="Microsoft.NET.Sdk">

  <!-- The BejView window (Avalonia) plus the console commands info, find and paths. The exe is BejView.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BejView</AssemblyName>
    <RootNamespace>BejView.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\bejview.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The kernel32 imports in NativeConsole are source-generated and need unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Every runtime BejView ships for, so the lock file covers each publish (step 4, 2026-11-13). -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- The release is published single-file, which turns on the single-file analyzer and with it the ILLink package.
         On always, so a plain restore (CI's locked-mode test restore) and the publish restore agree (step 6, 2026-11-14). -->
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- Native Wayland on Linux (step 4, the user's choice 2026-11-13); X11 stays as the fallback. Does nothing on Windows. -->
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BejView.Core\BejView.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BejView.Tests" />
  </ItemGroup>

</Project>
